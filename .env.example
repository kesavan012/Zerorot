# ZeroRot Configuration
# Copy this file to .env and adjust values as needed.
# All settings below are optional — ZeroRot works with zero configuration.

# Maximum number of source files to include in the analysis (default: 15)
ZEROROT_MAX_FILES=15

# Maximum file size to read in KB (default: 200)
ZEROROT_MAX_FILE_SIZE_KB=200

# Output filename (default: README.md)
ZEROROT_OUTPUT_FILE=README.md

# Force overwrite existing README without prompting (default: false)
ZEROROT_FORCE=false
